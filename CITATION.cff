# CITATION.cff -- how to cite this repository, and the paper it belongs to.
#
# Affiliation is deliberately omitted here: the paper carries it, so it adds
# nothing to this file, and keeping one copy of it is easier to maintain than
# two.  The funding acknowledgement is likewise only in the paper.

cff-version: 1.2.0
message: "If you use this code, please cite the paper below."

title: "Reporting Protocol Determines the Measured Advantage of EEG Graph Neural Networks"
abstract: >-
  Code and result files reproducing every table and figure of a controlled study
  of AM-DGCN, an adaptive multi-scale dynamic graph convolutional network for
  EEG-based emotion recognition. The study isolates the contribution of the
  multi-scale graph hierarchy from that of a parallel linear shortcut under
  leave-one-subject-out evaluation on SEED, SEED-IV and DEAP, and includes
  matched linear-ceiling controls and a ten-variant ablation.
version: "v1.0.2"
date-released: "2026-10-18"
license: MIT
doi: "10.5281/zenodo.22933602"

# The concept DOI ("all versions") is used here because this file ships inside
# every archived snapshot: a version DOI would be stale in the very record that
# contains it.  The concept DOI always resolves to the newest version --
# 10.5281/zenodo.22933603 was v1.0.1, and it is the version DOI of v1.0.2 that
# the paper cites in its Data availability statement.

# NOTE: `version` is the tag name, so it tracks whatever tag was released --
# not the project's own semver intent.  The first attempt was tagged v1.0.0 and
# archived nothing; re-tagging produced v1.0.1, which is now the ONLY archived
# version (Zenodo concept 10.5281/zenodo.22933602 lists exactly one record).
# There is therefore no citable v1.0.0 DOI, and this file must not claim one.
# The tag itself lives on GitHub and is deliberately left alone: as the only
# archived version, v1.0.1 is the citable one, and deleting it would redirect
# every future citation of that DOI to a fresh, differently-numbered record.

repository-code: "https://github.com/ray2k0101-dollaryu/am-dgcn"

authors:
  - family-names: Yu
    given-names: Lei
  - family-names: Ding
    given-names: Rongtao
  - family-names: Wang
    given-names: Decheng

preferred-citation:
  type: article
  title: "Reporting Protocol Determines the Measured Advantage of EEG Graph Neural Networks"
  authors:
    - family-names: Yu
      given-names: Lei
    - family-names: Ding
      given-names: Rongtao
    - family-names: Wang
      given-names: Decheng
  year: 2026
